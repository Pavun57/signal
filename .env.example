# ============================================================================
# Signal environment variables
# ============================================================================
# Copy this file to .env.local (for `pnpm dev`) or .env (for Docker) and
# fill in the values. Keys are grouped by required / optional. You only need
# the "required" block to get a dev server running.
#
# Run `pnpm setup` for an interactive walkthrough that fills this in for you.
# ============================================================================


# ----------------------------------------------------------------------------
# REQUIRED: Supabase (database, auth, storage)
# ----------------------------------------------------------------------------
# Create a project at https://supabase.com/dashboard. You'll find these under
# Project Settings → API. Signal supports both the new "publishable" key and
# the legacy anon key — set whichever your project exposes.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=

# Server-side Supabase access. SERVICE_ROLE_KEY bypasses RLS — keep it secret,
# never expose to the browser. Required for admin operations (cost reports,
# webhook handlers). ANON_KEY / SUPABASE_URL are fallbacks for non-cookie code paths.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=


# ----------------------------------------------------------------------------
# REQUIRED: Clerk (auth)
# ----------------------------------------------------------------------------
# Sign up at https://clerk.com and create an application. Copy the publishable
# and secret keys from API Keys. The Frontend API domain is the host portion
# of "Frontend API URL" (e.g. `your-app.clerk.accounts.dev`) — Supabase needs
# it to validate Clerk-issued JWTs as the third-party auth provider.
#
# In dev, all three can be left blank: Next.js Clerk runs in Keyless mode and
# auto-generates a temporary application on first load. RLS-backed reads will
# fail until you fill these in and configure Clerk → Supabase in the Clerk
# dashboard ("Connect with Supabase"). Free tier covers 10k MAU.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_FRONTEND_API_DOMAIN=

# Self-hosted Docker only (Dokploy, Coolify, plain docker run): a runtime copy
# of the publishable key. Next bakes NEXT_PUBLIC_* into the image at build
# time, so without build args the container never sees the one above. Signal's
# proxy + root layout read this unprefixed var per request instead.
# Local dev (`pnpm dev`) doesn't need it — the NEXT_PUBLIC_ var is enough.
CLERK_PUBLISHABLE_KEY=

# Custom Clerk URLs — keep these defaults so /login and /signup match the
# routes shipped in src/app/(auth). Override only if you move the routes.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/


# ----------------------------------------------------------------------------
# REQUIRED: AI model (any OpenAI-compatible endpoint — powers chat,
# enrichment, and drafts)
# ----------------------------------------------------------------------------
# Bearer token for the endpoint below. For Anthropic (the default), get a key
# at https://console.anthropic.com (starts with `sk-ant-api...`).
# ANTHROPIC_API_KEY is still accepted as a fallback name for existing installs.
AI_API_KEY=

# Any OpenAI-compatible /v1 root. Defaults shown; uncomment to switch.
#   Anthropic:  https://api.anthropic.com/v1
#   OpenAI:     https://api.openai.com/v1
#   OpenRouter: https://openrouter.ai/api/v1
AI_BASE_URL=https://api.anthropic.com/v1

# One model is used for every task (chat, composition, extraction, verdicts).
AI_MODEL=claude-sonnet-4-6

# OPTIONAL: per-million-token USD rates for the cost center's estimates.
# Defaults match the default model; set these to match whatever you point at.
# AI_INPUT_PRICE_PER_MTOK=3.0
# AI_OUTPUT_PRICE_PER_MTOK=15.0

# OPTIONAL: Stagehand (browser steps) model override, full "provider/model"
# form. Derived from AI_BASE_URL + AI_MODEL when unset.
# AI_STAGEHAND_MODEL=anthropic/claude-sonnet-4-6

# OPTIONAL: Anthropic admin key for billed-total cost reporting (only applies
# when AI_BASE_URL points at Anthropic). Starts with `sk-ant-admin...` —
# distinct from your regular API key.
ANTHROPIC_ADMIN_KEY=


# ----------------------------------------------------------------------------
# OPTIONAL: Browserbase + Stagehand (web scraping, YC scraper, job signals)
# ----------------------------------------------------------------------------
# Sign up at https://www.browserbase.com. Without these, any feature that
# relies on browser automation (hiring signals, YC scraper, generic web
# extraction) will fail gracefully with a "not configured" message.
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# Stagehand uses your AI provider for DOM reasoning -- it reuses AI_API_KEY
# and AI_BASE_URL from the section above, no extra key needed.


# ----------------------------------------------------------------------------
# OPTIONAL: Email sending (Gmail app-password transport)
# ----------------------------------------------------------------------------
# Key for encrypting users' Gmail app passwords at rest (AES-256-GCM).
# Required before anyone connects Gmail in Settings > Email. Without it,
# outreach sequences can be drafted but not sent.
# Generate: openssl rand -base64 32
EMAIL_CREDENTIALS_KEY=


# ----------------------------------------------------------------------------
# OPTIONAL: Job scheduler (scheduled signal runs, reply tracking, follow-ups)
# ----------------------------------------------------------------------------
# Shared secret for /api/jobs/tick and /api/jobs/run. Vercel Cron sends it
# automatically once set. Generate with: openssl rand -hex 32
# Without it, recurring jobs never run: no scheduled signals, no reply
# detection, no sequence follow-ups.
CRON_SECRET=


# ----------------------------------------------------------------------------
# OPTIONAL: data providers (enrichment + signals)
# ----------------------------------------------------------------------------
# Exa — neural web search (https://exa.ai).
EXA_API_KEY=

# OPTIONAL: Exa service API key + key ID for the cost-tracking dashboard.
# Generate a service API key in Exa's admin dashboard (distinct from the
# search key above) and the UUID of the search key whose usage you want
# to fetch. Without these, Exa falls back to local estimates.
EXA_SERVICE_API_KEY=
EXA_API_KEY_ID=

# Email finder + verifier. Signal's own discovery (team-page scrape, Exa,
# pattern guessing) is free but unproven -- the only network check is an MX
# lookup, which tells you the domain accepts mail, not that the mailbox exists.
# A verifier is what lets a pattern guess be trusted, and what keeps a bad
# address out of the send queue.
#
# Without this, discovery still works, but nothing is ever confirmed and the
# send gate blocks unverified addresses -- so expect few sendable contacts.
#
# Set EMAIL_PROVIDER=hunter (the only adapter shipped today) or leave it unset
# / `none` for free-only behaviour. Key: https://hunter.io/api-keys
EMAIL_PROVIDER=
HUNTER_API_KEY=

# Google Places (https://developers.google.com/maps/documentation/places/web-service).
GOOGLE_API_KEY=

# Apify — LinkedIn + X scraping (https://apify.com).
APIFY_API_TOKEN=

# GitHub — required for GitHub-based signals (commit activity, release cadence).
# Generate at https://github.com/settings/tokens (fine-grained recommended,
# read-only public_repo is usually enough).
GITHUB_TOKEN=


# ----------------------------------------------------------------------------
# OPTIONAL: PostHog (product analytics + session replay)
# ----------------------------------------------------------------------------
# Sign up at https://posthog.com. Each self-hosted Signal instance points at
# its OWN PostHog project — events from your deployment go to whoever owns
# this token, not to the upstream Signal repo. Leave blank to disable
# analytics entirely (client init and server captures both no-op).
#
# Token: Project Settings → Project API Key (starts with `phc_`).
# Host:  https://us.i.posthog.com (US cloud) or https://eu.i.posthog.com (EU).
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=


# ----------------------------------------------------------------------------
# OPTIONAL: deployment URL (Vercel sets VERCEL_URL automatically)
# ----------------------------------------------------------------------------
# The public URL your instance is reachable at. Used for webhook callbacks.
# Defaults to http://localhost:3000 locally.
NEXT_PUBLIC_APP_URL=

# Auto-set by Vercel (hostname without protocol, e.g. `myapp.vercel.app`).
# Used as a fallback base URL for the job scheduler's self-invocations. Leave
# unset outside of Vercel — NEXT_PUBLIC_APP_URL is the preferred override.
VERCEL_URL=
